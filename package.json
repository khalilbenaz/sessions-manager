{
  "name": "sessions-manager",
  "version": "1.0.2",
  "description": "Une fenêtre pour piloter plusieurs sessions Claude Code et Antigravity CLI en parallèle : sessions persistantes, état en direct, historique, reprise automatique.",
  "bin": {
    "sm": "bin/sm.js",
    "sessions": "bin/sm.js"
  },
  "main": "electron/main.js",
  "files": [
    "bin/",
    "lib/",
    "public/",
    "scripts/",
    "electron/",
    "server.js",
    "hook.js",
    "pick-folder.ps1",
    "README.md"
  ],
  "scripts": {
    "postinstall": "node scripts/postinstall.js",
    "start": "node server.js",
    "app": "electron .",
    "dist:win": "electron-builder --win --x64",
    "dist:mac": "electron-builder --mac --arm64 --x64",
    "dist:linux": "electron-builder --linux AppImage deb --x64",
    "test": "node --test --test-concurrency=1 test/server.test.js",
    "test:app": "node --test --test-concurrency=1 test/app.test.js",
    "guide": "node scripts/build-guide.js",
    "build": "node scripts/build-guide.js"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "claude",
    "claude-code",
    "agy",
    "antigravity",
    "terminal",
    "sessions",
    "gemini",
    "ai-agent",
    "workspace"
  ],
  "author": {
    "name": "Khalil Benazzouz",
    "email": "khalilbenaz@users.noreply.github.com"
  },
  "license": "MIT",
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "electron-updater": "^6.8.9",
    "node-pty": "^1.1.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "playwright-core": "^1.63.0"
  },
  "productName": "Sessions Manager",
  "build": {
    "appId": "com.sessions-manager.app",
    "productName": "Sessions Manager",
    "copyright": "Khalil Benazzouz",
    "asar": false,
    "npmRebuild": false,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "bin/**",
      "lib/**",
      "public/**",
      "scripts/**",
      "electron/**",
      "server.js",
      "hook.js",
      "pick-folder.ps1",
      "package.json",
      "!**/*.pdb",
      "!**/*.map",
      "!test/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icon.ico",
      "artifactName": "Sessions-Manager-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Sessions Manager",
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.developer-tools",
      "artifactName": "Sessions-Manager-${version}-${arch}.${ext}",
      "identity": "-",
      "hardenedRuntime": false
    },
    "dmg": {
      "title": "Sessions Manager ${version}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "maintainer": "Khalil Benazzouz <khalilbenaz@users.noreply.github.com>",
      "icon": "build/icon.png",
      "category": "Development",
      "artifactName": "Sessions-Manager-${version}-${arch}.${ext}"
    },
    "deb": {
      "synopsis": "Sessions Manager — Claude Code & Antigravity CLI",
      "description": "Une fenêtre unifiée pour piloter plusieurs sessions Claude Code et Antigravity CLI en parallèle."
    },
    "appImage": {
      "artifactName": "Sessions-Manager-${version}-${arch}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "khalilbenaz",
        "repo": "sessions-manager",
        "releaseType": "release"
      }
    ]
  },
  "homepage": "https://github.com/khalilbenaz/sessions-manager",
  "repository": {
    "type": "git",
    "url": "https://github.com/khalilbenaz/sessions-manager.git"
  },
  "bugs": {
    "url": "https://github.com/khalilbenaz/sessions-manager/issues"
  }
}
